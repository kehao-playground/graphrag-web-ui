# Test-only values for deploy/test-idp (second --env-file after .env).
# Everything here is public: never reuse any of it in a deployment.
AUTH_MODE=proxy
PROXY_ADMIN_EMAILS=admin@example.com
PROXY_AUTH_SECRET=test-idp-proxy-secret-not-for-production-use
