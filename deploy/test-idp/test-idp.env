OAUTH2_PROXY_ISSUER_URL=http://localhost:5556/dex
OAUTH2_PROXY_CLIENT_ID=graphrag-ui-test
OAUTH2_PROXY_CLIENT_SECRET=test-idp-client-secret
OAUTH2_PROXY_COOKIE_SECRET=dGVzdC1pZHAtY29va2llLXNlY3JldC0zMmJ5dGVzISE=
OAUTH2_PROXY_REDIRECT_URL=http://localhost:8080/oauth2/callback
OAUTH2_PROXY_EMAIL_DOMAINS=example.com
OAUTH2_PROXY_COOKIE_SECURE=false
