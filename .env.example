# GraphRAG Web UI 環境變數(spec §8.3 — 十五個固定名稱,開發/生產共用)

# PostgreSQL 連線字串(asyncpg driver)
DATABASE_URL=postgresql+asyncpg://graphrag:graphrag@localhost:5432/graphrag

# 專案 workspace 根目錄(每個專案一個子目錄)
WORKSPACES_DIR=./data/workspaces

# JWT 簽章密鑰 — 生產環境必須換成隨機長字串
JWT_SECRET=dev-secret-change-me

# 首次啟動建立的 admin 帳號(空字串 = 不建立)
# ⚠ email 必須是真實可路由網域,不可用 .local — 登入驗證拒絕 special-use domains
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# 單檔上傳上限(MiB)— 超過 → 413
UPLOAD_MAX_FILE_MB=50

# 每專案儲存配額(MiB;input/ + output/ 合計)— 超過 → 413
PROJECT_QUOTA_MB=5000

# Max indexing/update jobs executing concurrently (0 disables the runner loop)
MAX_CONCURRENT_JOBS=2

# Days to keep log files of succeeded jobs (logs/jobs/<id>.log; DB rows stay)
JOB_LOG_RETENTION_DAYS=30

# Days to keep log files of failed/cancelled jobs (longer, for postmortems)
JOB_LOG_FAILED_RETENTION_DAYS=90

# Timestamp dirs kept under each project's update_output/ after a merge
UPDATE_OUTPUT_KEEP_LATEST=2

# Cache volume quota reported by preflight (MiB; exceed → launch warning)
CACHE_QUOTA_MB=2048

# Minimum free MiB on the workspaces volume; below → enqueue refused
DISK_WATERMARK_MB=2048

# LRU frame-cache budget for query result parquet frames, MiB (spec §6.4)
QUERY_CACHE_MB=1024

# Max queries per (user, project) per hour before 429
QUERY_RATE_LIMIT_PER_HOUR=30
